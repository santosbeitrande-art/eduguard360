{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/public/login",
      "destination": "/public/login.html?v=2026-08-06-loginfix",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/public/login",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/public/login.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/favicon.ico",
      "destination": "/favicon.ico"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/api/v1/building360/(.*)",
      "destination": "/api/v1/core?action=building360-proxy&path=$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://api.eduguard360.co.mz/api/$1"
    },
    {
      "source": "/verify-api/(.*)",
      "destination": "https://api.eduguard360.co.mz/$1"
    },
    {
      "source": "/public",
      "destination": "/public/index.html?v=2026-08-06-loginfix"
    },
    {
      "source": "/public/",
      "destination": "/public/index.html?v=2026-08-06-loginfix"
    },
    {
      "source": "/public/login",
      "destination": "/public/login.html?v=2026-08-06-loginfix"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}