{
  "name": "ecotrade360-backend",
  "version": "1.0.0",
  "description": "API Backend para EcoTrade360 - Marketplace de Reciclagem",
  "main": "dist/main.js",
  "scripts": {
    "start": "node dist/main.js",
    "dev": "ts-node src/main.ts",
    "build": "tsc",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "typeorm": "node --require dotenv/config --require ts-node/register/transpile-only ./node_modules/typeorm/cli.js -d src/config/typeorm.datasource.ts",
    "typeorm:migrate": "npm run typeorm -- migration:generate src/database/migrations/AutoMigration",
    "typeorm:run": "npm run typeorm -- migration:run",
    "typeorm:revert": "npm run typeorm -- migration:revert",
    "db:check:ownerrole": "node ./scripts/check-ownerRole-column.cjs",
    "db:apply:ownerrole": "powershell -ExecutionPolicy Bypass -File ./scripts/apply-ownerrole-migration.ps1"
  },
  "keywords": [
    "ecotrade",
    "reciclagem",
    "marketplace",
    "api",
    "nestjs"
  ],
  "author": "EcoTrade360",
  "license": "MIT",
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.8",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "^11.0.3",
    "@types/nodemailer": "^8.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "helmet": "^7.1.0",
    "nodemailer": "^10.0.16",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.1.13",
    "typeorm": "^0.3.17",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.8",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.6",
    "@types/passport-jwt": "^3.0.13",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "multer": "^2.5.0",
    "typeorm": {
      "glob": "^14.0.3"
    }
  }
}
